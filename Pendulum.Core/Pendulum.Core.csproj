<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.14" />
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <!-- Pendulum is x64 only: of whisper.cpp's Windows libraries, which Whisper.net.Runtime adds for
       x64, x86 and arm64 (runtimes\win-*\), keep only x64's. The others are never loaded, and
       would only make the installer and the install folder bigger. Dropped here, where the package
       adds them, so the App's build, publish, installer and portable zip never see them. -->
  <Target Name="KeepOnlyX64Whisper" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/win-x86/')) Or $([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/win-arm64/'))" />
    </ItemGroup>
  </Target>

  <!-- Core's user-visible text (the repeat descriptions), English to start. The CoreStrings class
       is generated from Resources\CoreStrings.resx before compiling, as Pendulum.App's Strings is. -->
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)CoreStrings.Designer.cs" Visible="false" />
  </ItemGroup>
  <Target Name="GenerateCoreStrings" BeforeTargets="CoreCompile"
          Inputs="Resources\CoreStrings.resx" Outputs="$(IntermediateOutputPath)CoreStrings.Designer.cs">
    <GenerateResource Sources="Resources\CoreStrings.resx" OutputResources="$(IntermediateOutputPath)CoreStringsClass.resources"
                      StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Pendulum.Core.Resources" StronglyTypedClassName="CoreStrings"
                      StronglyTypedManifestPrefix="Pendulum.Core.Resources" StronglyTypedFileName="$(IntermediateOutputPath)CoreStrings.Designer.cs"
                      ExecuteAsTool="false" />
  </Target>

</Project>
