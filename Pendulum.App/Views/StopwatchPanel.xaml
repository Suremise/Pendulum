<UserControl x:Class="Pendulum.App.Views.StopwatchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pendulum.App.ViewModels">
    <UserControl.DataContext>
        <vm:StopwatchViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">

            <ui:Card Margin="0,0,0,20" Padding="40,36">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="STOPWATCH" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding DisplayTime}" FontSize="64" FontWeight="Light"
                               HorizontalAlignment="Center" FontFamily="Consolas"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <ui:Button Content="{Binding StartPauseLabel}" Appearance="Primary" Width="130" Height="44"
                           FontSize="15" Command="{Binding StartPauseCommand}" Margin="0,0,12,0"/>
                <ui:Button Content="Lap" Appearance="Secondary" Width="100" Height="44" FontSize="15"
                           Command="{Binding LapCommand}" Margin="0,0,12,0"/>
                <ui:Button Content="Reset" Appearance="Secondary" Width="100" Height="44" FontSize="15"
                           Command="{Binding ResetCommand}"/>
            </StackPanel>

            <ui:Card Padding="0" MaxHeight="220" Visibility="{Binding HasLaps, Converter={StaticResource BoolToVis}}">
                <ListBox ItemsSource="{Binding Laps}" BorderThickness="0" Background="Transparent" Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="14" Padding="12,8"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ui:Card>
        </StackPanel>
    </Grid>
</UserControl>
