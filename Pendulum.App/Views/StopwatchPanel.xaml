<UserControl x:Class="Pendulum.App.Views.StopwatchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pendulum.App.ViewModels"
             xmlns:conv="clr-namespace:Pendulum.App.Converters">
    <UserControl.DataContext>
        <vm:StopwatchViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="440" Margin="0,40,0,0">

            <ui:Card Margin="0,0,0,20" Padding="40,36">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="STOPWATCH" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding DisplayTime}" FontSize="64" FontWeight="Light"
                               HorizontalAlignment="Center" FontFamily="Consolas"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <ui:Button Content="{Binding StartPauseLabel}" Appearance="Primary" Width="130" Height="44"
                           FontSize="15" Command="{Binding StartPauseCommand}" Margin="0,0,12,0"/>
                <ui:Button Content="Lap" Appearance="Secondary" Width="100" Height="44" FontSize="15"
                           Command="{Binding LapCommand}" Margin="0,0,12,0"/>
                <ui:Button Content="Reset" Appearance="Secondary" Width="100" Height="44" FontSize="15"
                           Command="{Binding ResetCommand}"/>
            </StackPanel>

            <ui:Card Padding="0" Height="220">
                <Grid>
                    <ListBox ItemsSource="{Binding Laps}" BorderThickness="0" Background="Transparent" Padding="8"
                              Visibility="{Binding HasLaps, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Number, StringFormat='Lap {0}'}"
                                               FontFamily="Consolas" FontSize="14" Padding="12,6"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Time}" FontFamily="Consolas" FontSize="14"
                                               Padding="12,6" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="No laps recorded yet" FontSize="13"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasLaps, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </ui:Card>
        </StackPanel>
    </Grid>
</UserControl>
