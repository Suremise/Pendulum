<UserControl x:Class="Pendulum.App.Views.CalendarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Pendulum.App.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pendulum.App.ViewModels"
             xmlns:conv="clr-namespace:Pendulum.App.Converters"
             xmlns:services="clr-namespace:Pendulum.App.Services">
    <UserControl.DataContext>
        <vm:CalendarViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:DateTimeDisplayConverter x:Key="DateTimeDisplay"/>

        <!-- A reminder chip, in the reminder's own colour (ReminderColors, from the palette): a tint
             of it with a bar of its shade at the start, the theme's text on it (4.5:1 or more in
             light and dark, ThemeColourTests). Neutral once it has gone off. A chip is one line,
             ChipLine high with its gap (CalendarPanel.xaml.cs fits the day's chips to its cell). -->
        <Style x:Key="ReminderPillBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="5,0,5,0"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="services:PaletteBrush.Background" Value="{Binding DisplayColor}"/>
            <Setter Property="services:PaletteBrush.BorderBrush" Value="{Binding DisplayColor}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFired}" Value="True">
                    <Setter Property="services:PaletteBrush.Background" Value="{x:Null}"/>
                    <Setter Property="services:PaletteBrush.BorderBrush" Value="{x:Null}"/>
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReminderPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFired}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Invisible chrome so a Button can host a badge-styled pill and still be clickable. -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- "+N more": plain text in the theme's secondary text colour, one chip line high, with
             room below it; under the pointer or while its list is open, the primary text colour. -->
        <Style x:Key="OverflowChip" TargetType="ToggleButton">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="2,0,2,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverflowPopupBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PendulumPopupBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="DayCellTemplate">
            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0.6" Padding="6,3">
                <!-- The day's number, then its chips, then "+N more" for those that don't fit
                     (CalendarDayCell.Lines). A cell too short for even one line under the number
                     (a small window) shows "+N more" beside the number instead. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" Margin="0,0,0,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PendulumAccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Date.Day}" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleReminders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PillButton}"
                                            Command="{Binding DataContext.EditReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Border Style="{StaticResource ReminderPillBadge}">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource ReminderPillText}"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ToggleButton x:Name="OverflowToggle"
                                  Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVis}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource OverflowChip}">
                                <Setter Property="Grid.Row" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                        <Setter Property="Grid.Row" Value="0"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                        <Setter Property="Height" Value="18"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <TextBlock Text="{Binding OverflowText}" FontSize="10" FontWeight="SemiBold"/>
                    </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=OverflowToggle}" IsOpen="{Binding IsChecked, ElementName=OverflowToggle}"
                               StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                            <Border Style="{StaticResource OverflowPopupBorder}" MinWidth="160" MaxWidth="260">
                                <StackPanel>
                                    <TextBlock Text="{Binding Date, Converter={StaticResource DateTimeDisplay}, ConverterParameter=Date}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Reminders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PillButton}" Margin="0,0,0,4"
                                                        Command="{Binding DataContext.EditReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Style="{StaticResource ReminderPillBadge}" Margin="0" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ReminderPillText}"/>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{x:Static res:Strings.Calendar_Calendar}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Static res:Strings.Calendar_SeeYourRemindersLaidOutByDay}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="{x:Static res:Strings.Calendar_Today}" Appearance="Secondary" Margin="0,0,10,0" Command="{Binding TodayCommand}"/>
                <ui:Button Content="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource NavButton}"
                           Margin="0,0,6,0" Command="{Binding PreviousMonthCommand}"/>
                <ComboBox ItemsSource="{Binding MonthNames}" SelectedIndex="{Binding SelectedMonthIndex}"
                          Width="120" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}"
                          Width="80" Margin="0,0,6,0"/>
                <ui:Button Content="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource NavButton}"
                           Command="{Binding NextMonthCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding WeekdayHeaders}" Margin="0,10,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="DayGrid" Grid.Row="1" ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayCellTemplate}"
                              SizeChanged="DayGrid_SizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="6" Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
