<ui:FluentWindow x:Class="Pendulum.App.Views.TriggerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Pendulum.App.Resources"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:services="clr-namespace:Pendulum.App.Services"
        Title="{x:Static res:Strings.Edit_Reminder}"
        Width="650"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <!-- A colour swatch: a disc in the colour's shade (3:1 or more on the window), ringed in the
             theme's text colour when chosen, in its strong edge under the pointer, and dashed when
             it has the keyboard focus. The swatches are radio buttons, so the arrow keys move
             between them and a screen reader reads each one's name. -->
        <Style x:Key="ColourSwatch" TargetType="RadioButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                            <Ellipse Margin="5" services:PaletteBrush.Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter TargetName="Ring" Property="StrokeDashArray" Value="2 1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="EditorTitleBar" Title="{x:Static res:Strings.Edit_NewReminder}" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="28,4,28,28">

            <ui:TextBox x:Name="NameBox" PlaceholderText="{x:Static res:Strings.Edit_ReminderName}" FontSize="18" Margin="0,0,0,14" ClearButtonEnabled="False"/>

            <!-- Its colour, on the calendar and by its name in the Reminders list. -->
            <TextBlock x:Name="ColourLabel" Text="{x:Static res:Strings.Edit_Colour}" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <StackPanel x:Name="ColourChoices" Orientation="Horizontal"
                            AutomationProperties.LabeledBy="{Binding ElementName=ColourLabel}"/>
                <TextBlock x:Name="ColourNameText" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <ui:Card Margin="0,0,0,14">
                <StackPanel Margin="4">
                    <TextBlock Text="{x:Static res:Strings.Edit_STARTDATETIME}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition x:Name="AmPmSpacerColumn" Width="8"/>
                            <ColumnDefinition x:Name="AmPmColumn" Width="76"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="DatePickerControl" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="HourBox" Grid.Column="2"/>
                        <ComboBox x:Name="MinuteBox" Grid.Column="4"/>
                        <ComboBox x:Name="SecondBox" Grid.Column="6"/>
                        <ComboBox x:Name="AmPmBox" Grid.Column="8" Padding="10,6"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="{x:Static res:Strings.Edit_Repeat}" Appearance="Secondary" Click="RepeatButton_Click"/>
                        <TextBlock Grid.Column="1" x:Name="RecurrenceSummaryText" Text="{x:Static res:Strings.Edit_DoesNotRepeat}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>

                    <Border x:Name="RecurrenceNotice" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="6" Padding="10,8" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            <Run Text="{x:Static res:Strings.Edit_ThisReminderWillAutomaticallyRescheduleToItsNext}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,0,0,14">
                <StackPanel Margin="4">
                    <TextBlock Text="{x:Static res:Strings.Edit_ALERTTYPE}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>

                    <ComboBox x:Name="AlertTypeBox" Margin="0,0,0,16" SelectionChanged="AlertTypeBox_SelectionChanged"/>

                    <TextBlock x:Name="SoundLabel" Text="{x:Static res:Strings.Edit_Sound}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SoundBox" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="VolumeLabel" Text="{x:Static res:Strings.Edit_Volume}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" x:Name="VolumeValueText" Text="100" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" Margin="0,0,0,14"
                            ValueChanged="VolumeSlider_ValueChanged"/>

                    <TextBlock x:Name="PhraseLabel" Text="{x:Static res:Strings.Edit_PhraseToSpeak}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <ui:TextBox x:Name="PhraseBox" AcceptsReturn="True" TextWrapping="Wrap" Height="56" ClearButtonEnabled="False"/>
                </StackPanel>
            </ui:Card>

            <CheckBox x:Name="EnabledBox" Margin="4,0,0,22"
                      Checked="EnabledBox_CheckedChanged" Unchecked="EnabledBox_CheckedChanged">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.Edit_Enable}"/>
                    <TextBlock x:Name="DisabledHint" Text="{x:Static res:Strings.Edit_Disabled}" Foreground="{DynamicResource PendulumErrorTextBrush}" Visibility="Collapsed"/>
                </StackPanel>
            </CheckBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="{x:Static res:Strings.Edit_Test}" Appearance="Secondary" Click="TestButton_Click"/>
                <ui:Button Grid.Column="2" Content="{x:Static res:Strings.Edit_Cancel}" Appearance="Secondary" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <ui:Button Grid.Column="3" Content="{x:Static res:Strings.Edit_SaveReminder}" Appearance="Primary" Click="SaveButton_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
