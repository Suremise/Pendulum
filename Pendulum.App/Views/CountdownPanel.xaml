<UserControl x:Class="Pendulum.App.Views.CountdownPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pendulum.App.ViewModels"
             xmlns:conv="clr-namespace:Pendulum.App.Converters">
    <UserControl.DataContext>
        <vm:CountdownViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="640">

        <ui:Card Margin="0,0,0,14" Padding="30,18">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="COUNTDOWN" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding DisplayRemaining}" FontSize="42" FontWeight="Light"
                           HorizontalAlignment="Center" FontFamily="Consolas"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="days : hours : minutes : seconds" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </ui:Card>

        <UniformGrid Columns="2" Margin="0,0,0,14">

            <Border Margin="0,0,8,0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Margin="16">
                    <TextBlock Text="DURATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Days" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hours" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Minutes" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Seconds" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ui:Button Content="Set" Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                               Command="{Binding SetDurationCommand}"/>
                </StackPanel>
            </Border>

            <Border Margin="8,0,0,0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Margin="16">
                    <TextBlock Text="ALERT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>

                    <TextBlock Text="Label" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="Sound" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SoundFileName}" Margin="0,0,0,12"/>

                    <CheckBox Content="Also speak a phrase" IsChecked="{Binding SpeakPhrase}" Margin="0,0,0,8"/>
                    <ui:TextBox Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SpeakPhrase}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
            <ui:Button Content="Start" Appearance="Primary" Width="110" Height="40" FontSize="15"
                       Command="{Binding StartCommand}" Margin="0,0,12,0"
                       Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}"/>
            <ui:Button Content="Pause" Appearance="Secondary" Width="110" Height="40" FontSize="15"
                       Command="{Binding PauseCommand}" Margin="0,0,12,0"
                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
            <ui:Button Content="Resume" Appearance="Primary" Width="110" Height="40" FontSize="15"
                       Command="{Binding ResumeCommand}" Margin="0,0,12,0"
                       Visibility="{Binding IsPausedState, Converter={StaticResource BoolToVis}}"/>
            <ui:Button Content="Reset" Appearance="Secondary" Width="110" Height="40" FontSize="15"
                       Command="{Binding ResetCommand}"/>
        </StackPanel>
    </StackPanel>
    </Grid>
</UserControl>
