<ui:FluentWindow x:Class="Pendulum.App.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Pendulum.App.Resources"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{x:Static res:Strings.QuickAdd_QuickReminder}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static res:Strings.QuickAdd_QuickReminder}" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="24,4,24,24">
            <TextBlock Text="{x:Static res:Strings.QuickAdd_EGCallMom3pmIn20MinStandupTomorrow9am}"
                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="InputBox" Grid.Column="0" FontSize="16" Padding="10,8"
                            PlaceholderText="{x:Static res:Strings.QuickAdd_WhatAndWhen}"
                            PreviewKeyDown="InputBox_PreviewKeyDown"/>
                <ui:Button x:Name="MicButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                           Appearance="Secondary" Click="MicButton_Click"
                           Icon="{ui:SymbolIcon Mic24}" ToolTip="{x:Static res:Strings.QuickAdd_SpeakAReminder}"/>
            </Grid>

            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#D13438"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{x:Static res:Strings.QuickAdd_Cancel}" Appearance="Secondary" Click="CancelButton_Click" Margin="0,0,10,0"/>
                <ui:Button Content="{x:Static res:Strings.QuickAdd_AddReminder}" Appearance="Primary" Click="AddButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
