<UserControl x:Class="Pendulum.App.Views.TriggersPanel"
             x:Name="RootControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pendulum.App.ViewModels"
             xmlns:conv="clr-namespace:Pendulum.App.Converters">
    <UserControl.DataContext>
        <vm:TriggersViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:EnumSpacedDisplayConverter x:Key="EnumSpaced"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:BoolToSelectColumnWidthConverter x:Key="SelectColumnWidth"/>
        <conv:NullToVisibilityConverter x:Key="ScheduledVis"/>
        <conv:InverseNullToVisibilityConverter x:Key="FixedVis"/>
        <conv:ReminderStatusVisibilityConverter x:Key="ReminderStatusVis"/>
        <SolidColorBrush x:Key="ScheduledBadgeBrush" Color="#337C6AE0"/>
        <SolidColorBrush x:Key="FixedBadgeBrush" Color="#333B82F6"/>
        <SolidColorBrush x:Key="UpcomingBadgeBrush" Color="#3322C55E"/>
        <SolidColorBrush x:Key="DisabledBadgeBrush" Color="#33F59E0B"/>
        <SolidColorBrush x:Key="PendulumAccentBrush" Color="#FF7C6AE0"/>
        <SolidColorBrush x:Key="FilterActiveBrush" Color="#4048A0FA"/>
        <SolidColorBrush x:Key="SoundOnlyBadgeBrush" Color="#332AA198"/>
        <SolidColorBrush x:Key="SoundSpeechBadgeBrush" Color="#33F0A020"/>
        <SolidColorBrush x:Key="SpeechOnlyBadgeBrush" Color="#33E0529A"/>
        <SolidColorBrush x:Key="SpentTextBrush" Color="#D9534F"/>
        <!-- ControlFillColorDefaultBrush (the panel's own background) is intentionally
             slightly translucent, which lets row content bleed through when it's reused
             inside an AllowsTransparency popup. This is that same colour forced fully
             opaque so the filter dropdowns render solid. -->
        <SolidColorBrush x:Key="ColumnFilterPopupOpaqueBrush" Color="#FF2D2D2D"/>
        <Style x:Key="NameText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFired}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SpentTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TriggersOnText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFired}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SpentTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TagBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,0,6,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="TagBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ModeBadge" TargetType="Border" BasedOn="{StaticResource TagBadge}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="SoundOnly">
                    <Setter Property="Background" Value="{StaticResource SoundOnlyBadgeBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="SoundAndSpeech">
                    <Setter Property="Background" Value="{StaticResource SoundSpeechBadgeBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="SpeechOnly">
                    <Setter Property="Background" Value="{StaticResource SpeechOnlyBadgeBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Initial sort (TriggerAt ascending) is applied in code-behind (ApplySort, called from
             Loaded) rather than declared here, so there's one source of truth shared with the
             column-header click-to-sort logic instead of two independent starting points. -->
        <CollectionViewSource x:Key="SortedTriggers" Source="{Binding Triggers}"/>
        <Style x:Key="CleanGridViewColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,10,10,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Top"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColumnFilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="ColumnFilterDropdownButton" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,6,10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColumnFilterPopupBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ColumnFilterPopupOpaqueBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColumnFilterCheckBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Plain Button (not ui:Button) with its own ControlTemplate: ui:Button's built-in hover
             state swaps its whole background to a fixed neutral grey regardless of what's set via
             style triggers, which drowns out the green/red enabled state. This button dims its own
             colour on hover/press instead, so it still reads as clickable without losing the colour. -->
        <Style x:Key="EnableToggleButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsEnabled" Value="{Binding HasFired, Converter={StaticResource InverseBool}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="True">
                    <Setter Property="ToolTip" Value="Disable"/>
                    <Setter Property="Background" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="ToolTip" Value="Enable"/>
                    <Setter Property="Background" Value="#C0392B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FiltersToggleButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasActiveFilters}" Value="True">
                    <Setter Property="Background" Value="{StaticResource FilterActiveBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Reminders" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Alarms that fire at an exact date and time." FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Margin="0,0,10,0">
                    <ui:Button Content="Filters" Icon="{ui:SymbolIcon Filter24}"
                               Style="{StaticResource FiltersToggleButton}"
                               Command="{Binding ToggleFilterRowCommand}"/>
                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource PendulumAccentBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                            IsHitTestVisible="False"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <ui:Button Content="Add Reminder" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding AddCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8">
            <Grid>
                <ListView ItemsSource="{Binding Source={StaticResource SortedTriggers}}" SelectedItem="{Binding SelectedTrigger}"
                          VerticalAlignment="Top"
                          BorderThickness="0" Background="Transparent"
                          Visibility="{Binding HasTriggers, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource CleanGridViewColumnHeader}">
                            <GridViewColumn Header="" Width="{Binding DataContext.IsSelecting, ElementName=RootControl, Converter={StaticResource SelectColumnWidth}}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelectedForBulk, Mode=TwoWay}" VerticalAlignment="Center"
                                                  BorderBrush="{StaticResource PendulumAccentBrush}" BorderThickness="1.5"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="235">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Name" Click="ColumnHeader_Click" Style="{StaticResource CleanGridViewColumnHeader}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="NAME" Style="{StaticResource ColumnFilterLabel}"/>
                                                <TextBlock x:Name="NameSortArrow" Style="{StaticResource ColumnFilterLabel}" FontSize="9" Margin="4,0,0,0" Foreground="{StaticResource PendulumAccentBrush}"/>
                                            </StackPanel>
                                            <ui:TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="Filter..." FontSize="12" FontWeight="Normal"
                                                        Padding="6,4" Margin="0,6,10,0"
                                                        Visibility="{Binding IsFilterRowVisible, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="10,0,0,0"
                                                   Style="{StaticResource NameText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="128">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="IsScheduled" Click="ColumnHeader_Click" Style="{StaticResource CleanGridViewColumnHeader}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="TYPE" Style="{StaticResource ColumnFilterLabel}"/>
                                            <TextBlock x:Name="TypeSortArrow" Style="{StaticResource ColumnFilterLabel}" FontSize="9" Margin="4,0,0,0" Foreground="{StaticResource PendulumAccentBrush}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="TypeFilterToggle" Content="{Binding TypeFilterSummary}"
                                                      Style="{StaticResource ColumnFilterDropdownButton}"
                                                      Visibility="{Binding IsFilterRowVisible, Converter={StaticResource BoolToVis}}"/>
                                        <Popup PlacementTarget="{Binding ElementName=TypeFilterToggle}" IsOpen="{Binding IsChecked, ElementName=TypeFilterToggle}"
                                               StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                            <Border Style="{StaticResource ColumnFilterPopupBorder}">
                                                <StackPanel>
                                                    <CheckBox Style="{StaticResource ColumnFilterCheckBox}" IsChecked="{Binding TypeFilterFixed}">
                                                        <Border Style="{StaticResource TagBadge}" Background="{StaticResource FixedBadgeBrush}">
                                                            <TextBlock Text="Fixed" Style="{StaticResource TagBadgeText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </CheckBox>
                                                    <CheckBox Style="{StaticResource ColumnFilterCheckBox}" Margin="0" IsChecked="{Binding TypeFilterScheduled}">
                                                        <Border Style="{StaticResource TagBadge}" Background="{StaticResource ScheduledBadgeBrush}">
                                                            <TextBlock Text="Scheduled" Style="{StaticResource TagBadgeText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </CheckBox>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Border Style="{StaticResource TagBadge}" Background="{StaticResource FixedBadgeBrush}"
                                                    Visibility="{Binding Recurrence, Converter={StaticResource FixedVis}}">
                                                <TextBlock Text="Fixed" Style="{StaticResource TagBadgeText}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource TagBadge}" Background="{StaticResource ScheduledBadgeBrush}"
                                                    Visibility="{Binding Recurrence, Converter={StaticResource ScheduledVis}}">
                                                <TextBlock Text="Scheduled" Style="{StaticResource TagBadgeText}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="177">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="TriggerAt" Click="ColumnHeader_Click" Style="{StaticResource CleanGridViewColumnHeader}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="TRIGGERS ON" Style="{StaticResource ColumnFilterLabel}"/>
                                            <TextBlock x:Name="TriggersOnSortArrow" Style="{StaticResource ColumnFilterLabel}" FontSize="9" Margin="4,0,0,0" Foreground="{StaticResource PendulumAccentBrush}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="DateFilterToggle" Content="{Binding TriggerFilterSummary}"
                                                      Style="{StaticResource ColumnFilterDropdownButton}"
                                                      Visibility="{Binding IsFilterRowVisible, Converter={StaticResource BoolToVis}}"/>
                                        <Popup PlacementTarget="{Binding ElementName=DateFilterToggle}" IsOpen="{Binding IsChecked, ElementName=DateFilterToggle}"
                                               StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                            <Border Style="{StaticResource ColumnFilterPopupBorder}">
                                                <StackPanel Width="190">
                                                    <TextBlock Text="From" FontSize="11" FontWeight="Normal"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <DatePicker SelectedDate="{Binding TriggerFromFilter}" Margin="0,0,0,10"/>
                                                    <TextBlock Text="To" FontSize="11" FontWeight="Normal"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <DatePicker SelectedDate="{Binding TriggerToFilter}" Margin="0,0,0,10"/>
                                                    <ui:Button Content="Clear" Appearance="Secondary" HorizontalAlignment="Left"
                                                               Command="{Binding ClearTriggerFilterCommand}"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TriggerAt, StringFormat='{}{0:ddd, dd MMM yyyy  HH:mm}'}" VerticalAlignment="Center" Margin="5,0,0,0"
                                                   Style="{StaticResource TriggersOnText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="150">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Mode" Click="ColumnHeader_Click" Style="{StaticResource CleanGridViewColumnHeader}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="MODE" Style="{StaticResource ColumnFilterLabel}"/>
                                            <TextBlock x:Name="ModeSortArrow" Style="{StaticResource ColumnFilterLabel}" FontSize="9" Margin="4,0,0,0" Foreground="{StaticResource PendulumAccentBrush}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="ModeFilterToggle" Content="{Binding ModeFilterSummary}"
                                                      Style="{StaticResource ColumnFilterDropdownButton}"
                                                      Visibility="{Binding IsFilterRowVisible, Converter={StaticResource BoolToVis}}"/>
                                        <Popup PlacementTarget="{Binding ElementName=ModeFilterToggle}" IsOpen="{Binding IsChecked, ElementName=ModeFilterToggle}"
                                               StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                            <Border Style="{StaticResource ColumnFilterPopupBorder}">
                                                <StackPanel>
                                                    <CheckBox Style="{StaticResource ColumnFilterCheckBox}" IsChecked="{Binding ModeFilterSoundOnly}">
                                                        <Border Style="{StaticResource TagBadge}" Background="{StaticResource SoundOnlyBadgeBrush}">
                                                            <TextBlock Text="Sound only" Style="{StaticResource TagBadgeText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </CheckBox>
                                                    <CheckBox Style="{StaticResource ColumnFilterCheckBox}" IsChecked="{Binding ModeFilterSoundAndSpeech}">
                                                        <Border Style="{StaticResource TagBadge}" Background="{StaticResource SoundSpeechBadgeBrush}">
                                                            <TextBlock Text="Sound + speech" Style="{StaticResource TagBadgeText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </CheckBox>
                                                    <CheckBox Style="{StaticResource ColumnFilterCheckBox}" Margin="0" IsChecked="{Binding ModeFilterSpeechOnly}">
                                                        <Border Style="{StaticResource TagBadge}" Background="{StaticResource SpeechOnlyBadgeBrush}">
                                                            <TextBlock Text="Speech only" Style="{StaticResource TagBadgeText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </CheckBox>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ModeBadge}" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Mode, Converter={StaticResource EnumSpaced}}" Style="{StaticResource TagBadgeText}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="87">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="SoundFileName" Click="ColumnHeader_Click" Style="{StaticResource CleanGridViewColumnHeader}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="SOUND" Style="{StaticResource ColumnFilterLabel}"/>
                                            <TextBlock x:Name="SoundSortArrow" Style="{StaticResource ColumnFilterLabel}" FontSize="9" Margin="4,0,0,0" Foreground="{StaticResource PendulumAccentBrush}"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SoundFileName}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="118">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="StatusSortOrder" Click="ColumnHeader_Click" Style="{StaticResource CleanGridViewColumnHeader}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="STATUS" Style="{StaticResource ColumnFilterLabel}"/>
                                            <TextBlock x:Name="StatusSortArrow" Style="{StaticResource ColumnFilterLabel}" FontSize="9" Margin="4,0,0,0" Foreground="{StaticResource PendulumAccentBrush}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="StatusFilterToggle" Content="{Binding StatusFilterSummary}"
                                                      Style="{StaticResource ColumnFilterDropdownButton}"
                                                      Visibility="{Binding IsFilterRowVisible, Converter={StaticResource BoolToVis}}"/>
                                        <Popup PlacementTarget="{Binding ElementName=StatusFilterToggle}" IsOpen="{Binding IsChecked, ElementName=StatusFilterToggle}"
                                               StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                                            <Border Style="{StaticResource ColumnFilterPopupBorder}">
                                                <StackPanel>
                                                    <CheckBox Style="{StaticResource ColumnFilterCheckBox}" IsChecked="{Binding StatusFilterUpcoming}">
                                                        <Border Style="{StaticResource TagBadge}" Background="{StaticResource UpcomingBadgeBrush}">
                                                            <TextBlock Text="Upcoming" Style="{StaticResource TagBadgeText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </CheckBox>
                                                    <CheckBox Style="{StaticResource ColumnFilterCheckBox}" IsChecked="{Binding StatusFilterSpent}">
                                                        <Border Style="{StaticResource TagBadge}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                            <TextBlock Text="Spent" Style="{StaticResource TagBadgeText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                    </CheckBox>
                                                    <CheckBox Style="{StaticResource ColumnFilterCheckBox}" Margin="0" IsChecked="{Binding StatusFilterDisabled}">
                                                        <Border Style="{StaticResource TagBadge}" Background="{StaticResource DisabledBadgeBrush}">
                                                            <TextBlock Text="Disabled" Style="{StaticResource TagBadgeText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Border>
                                                    </CheckBox>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Border Style="{StaticResource TagBadge}" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    Visibility="{Binding HasFired, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Spent" Style="{StaticResource TagBadgeText}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource TagBadge}" Background="{StaticResource UpcomingBadgeBrush}">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource ReminderStatusVis}">
                                                        <Binding Path="Enabled"/>
                                                        <Binding Path="HasFired"/>
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock Text="Upcoming" Style="{StaticResource TagBadgeText}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource TagBadge}" Background="{StaticResource DisabledBadgeBrush}">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource ReminderStatusVis}" ConverterParameter="Disabled">
                                                        <Binding Path="Enabled"/>
                                                        <Binding Path="HasFired"/>
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock Text="Disabled" Style="{StaticResource TagBadgeText}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="185">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Content="Edit" Appearance="Secondary" Padding="12,4"
                                                       Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Content="Delete" Appearance="Secondary" Padding="12,4" Margin="8,0,0,0"
                                                       Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource EnableToggleButton}"
                                                    Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Visibility="{Binding HasTriggers, Converter={StaticResource InverseBoolToVis}, FallbackValue=Collapsed}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60">
                    <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No reminders yet" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="Click &quot;Add Reminder&quot; to create your first alarm." FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="NoFilterResultsPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No reminders match these filters" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try adjusting or clearing the filters above." FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Content="{Binding SelectToggleLabel}" Appearance="Secondary" Margin="0,0,14,0"
                       Command="{Binding ToggleSelectCommand}"/>

            <TextBlock Grid.Column="1" Text="With selected:" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>

            <ui:Button Grid.Column="2" Content="Delete" Appearance="Danger" Margin="0,0,8,0"
                       IsEnabled="{Binding HasSelection}"
                       Command="{Binding DeleteSelectedCommand}"/>
            <ui:Button Grid.Column="3" Content="Export" Appearance="Secondary"
                       IsEnabled="{Binding HasSelection}"
                       Command="{Binding ExportSelectedCommand}"/>

            <ui:Button Grid.Column="5" Content="Import..." Appearance="Secondary"
                       Command="{Binding ImportCommand}"/>
        </Grid>
    </Grid>
</UserControl>
