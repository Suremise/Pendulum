<UserControl x:Class="Pendulum.App.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pendulum.App.ViewModels"
             xmlns:conv="clr-namespace:Pendulum.App.Converters"
             xmlns:models="clr-namespace:Pendulum.Core.Models;assembly=Pendulum.Core">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:EnumSpacedDisplayConverter x:Key="EnumSpaced"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- A section's title, a group's title, a row's label and a help line. -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,12"/>
        </Style>
        <!-- Help under a check box lines up with the box's text. -->
        <Style x:Key="CheckHelp" TargetType="TextBlock" BasedOn="{StaticResource Help}">
            <Setter Property="Margin" Value="28,0,0,12"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style x:Key="Group" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Field" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="260"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Number" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Width" Value="64"/>
            <Setter Property="ClearButtonEnabled" Value="False"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="Buttons" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Secondary" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <GridLength x:Key="LabelWidth">220</GridLength>

        <!-- The engines by plain names (the saved values stay the enum's). -->
        <DataTemplate x:Key="TtsEngineName">
            <TextBlock x:Name="Name" Text="Windows (built in)"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static models:TextToSpeechEngine.Piper}">
                    <Setter TargetName="Name" Property="Text" Value="Piper (offline, more natural)"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="SttEngineName">
            <TextBlock x:Name="Name" Text="Windows (built in)"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static models:SpeechToTextEngine.Whisper}">
                    <Setter TargetName="Name" Property="Text" Value="Whisper (offline, more accurate)"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The section list: the selected one tinted with a bar in the accent, as the main tabs are. -->
        <Style x:Key="SectionItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0,9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" Background="Transparent" Margin="2,0,10,0"/>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="14"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PendulumAccentSoftBrush}"/>
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource PendulumAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1040" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBlock Text="Choose a section on the left." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Arrow keys move between sections; Tab moves into the section shown. -->
        <ListBox x:Name="SectionList" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" BorderThickness="0" Background="Transparent"
                 ItemContainerStyle="{StaticResource SectionItem}" SelectedIndex="0" SelectionChanged="SectionList_SelectionChanged"
                 AutomationProperties.Name="Settings sections" KeyboardNavigation.TabNavigation="Once">
            <ListBoxItem Content="General" Tag="&#xE713;" AutomationProperties.Name="General"/>
            <ListBoxItem Content="Alerts" Tag="&#xE7BA;" AutomationProperties.Name="Alerts"/>
            <ListBoxItem Content="Spoken alerts" Tag="&#xE767;" AutomationProperties.Name="Spoken alerts"/>
            <ListBoxItem Content="Quick Reminder" Tag="&#xE720;" AutomationProperties.Name="Quick Reminder"/>
            <ListBoxItem Content="Backup and data" Tag="&#xE74E;" AutomationProperties.Name="Backup and data"/>
        </ListBox>

        <ScrollViewer x:Name="SectionScroller" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Grid MaxWidth="760" HorizontalAlignment="Stretch" Margin="0,0,12,4">

                <!-- General -->
                <StackPanel x:Name="GeneralSection" AutomationProperties.Name="General">
                    <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="When Pendulum starts" Style="{StaticResource GroupTitle}"/>
                            <CheckBox x:Name="LaunchOnStartupBox" Content="Start with Windows" IsChecked="{Binding Settings.LaunchOnWindowsStartup}"/>
                            <TextBlock Style="{StaticResource CheckHelp}" Text="Pendulum opens when you sign in, so your reminders go off even if you forget to start it."/>
                            <CheckBox x:Name="StartMinimizedBox" Content="Start in the tray" IsChecked="{Binding Settings.StartMinimized}"/>
                            <TextBlock Style="{StaticResource CheckHelp}" Text="Opens hidden in the notification area instead of showing this window."/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="Appearance" Style="{StaticResource GroupTitle}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ThemeLabel" Text="Theme" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="ThemeBox" Grid.Column="1" Style="{StaticResource Field}" Width="200"
                                          ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding Settings.Theme}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumSpaced}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TimeFormatLabel" Text="Time format" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="TimeFormatBox" Grid.Column="1" Style="{StaticResource Field}" Width="200" SelectedIndex="{Binding TimeFormatIndex}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=TimeFormatLabel}">
                                    <ComboBoxItem Content="12-hour (2:30 PM)"/>
                                    <ComboBoxItem Content="24-hour (14:30)"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="Updates" Style="{StaticResource GroupTitle}"/>
                            <CheckBox x:Name="UpdateCheckBox" Content="Check for updates when Pendulum starts" IsChecked="{Binding Settings.CheckForUpdatesOnStartup}"/>
                            <TextBlock Style="{StaticResource CheckHelp}" Margin="28,0,0,4"
                                       Text="Off unless you turn it on. When Pendulum starts, it asks GitHub whether a newer version exists (an answer is kept for a day) and shows a link in the status bar. Nothing is downloaded."/>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Alerts -->
                <StackPanel x:Name="AlertsSection" Visibility="Collapsed" AutomationProperties.Name="Alerts">
                    <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}"/>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="Sound" Style="{StaticResource GroupTitle}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DefaultSoundLabel" Text="Sound for new reminders" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="DefaultSoundBox" Grid.Column="1" Style="{StaticResource Field}" Width="200"
                                          ItemsSource="{Binding SoundFiles}" SelectedItem="{Binding Settings.DefaultSoundFileName}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=DefaultSoundLabel}"/>
                            </Grid>
                            <StackPanel Style="{StaticResource Buttons}" Margin="220,0,0,4">
                                <ui:Button Content="Add sound..." Style="{StaticResource Secondary}" Command="{Binding AddSoundCommand}"/>
                                <ui:Button Content="Open sounds folder" Style="{StaticResource Secondary}" Command="{Binding OpenSoundsFolderCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="When an alert appears" Style="{StaticResource GroupTitle}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SnoozeLabel" Text="Snooze for" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:TextBox x:Name="SnoozeBox" Style="{StaticResource Number}" MaxLength="3"
                                                Text="{Binding Settings.SnoozeMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="Snooze for, minutes"/>
                                    <TextBlock Text="minutes" Style="{StaticResource Unit}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="RepeatBox" Content="Keep alerting until I dismiss it" IsChecked="{Binding Settings.RepeatAlertUntilDismissed}"/>
                            <Grid Style="{StaticResource Row}" Margin="28,8,0,4"
                                  IsEnabled="{Binding Settings.RepeatAlertUntilDismissed, Converter={StaticResource InverseBool}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="192"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Otherwise dismiss it after" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:TextBox x:Name="AutoResolveBox" Style="{StaticResource Number}" MaxLength="3"
                                                Text="{Binding Settings.AutoResolveMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="Otherwise dismiss it after, minutes"/>
                                    <TextBlock Text="minutes" Style="{StaticResource Unit}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource CheckHelp}" Margin="28,0,0,4"
                                       Text="Used only when alerts don't keep going: an unanswered alert is dismissed for you, so a repeating reminder moves to its next time and a one-off is marked spent."/>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Spoken alerts -->
                <StackPanel x:Name="VoiceSection" Visibility="Collapsed" AutomationProperties.Name="Spoken alerts">
                    <TextBlock Text="Spoken alerts" Style="{StaticResource SectionTitle}"/>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="Voice" Style="{StaticResource GroupTitle}"/>
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,8" Text="Used for reminders set to speak, and for Test voice."/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TtsEngineLabel" Text="Speech engine" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="TtsEngineBox" Grid.Column="1" Style="{StaticResource Field}"
                                          ItemsSource="{Binding TextToSpeechEngines}" SelectedItem="{Binding Settings.TextToSpeechEngine}"
                                          ItemTemplate="{StaticResource TtsEngineName}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=TtsEngineLabel}"/>
                            </Grid>

                            <!-- Only the chosen engine's voices. -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Row}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.TextToSpeechEngine}" Value="{x:Static models:TextToSpeechEngine.Piper}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="WindowsVoiceLabel" Text="Windows voice" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="WindowsVoiceBox" Grid.Column="1" Style="{StaticResource Field}"
                                          ItemsSource="{Binding VoiceNames}" SelectedItem="{Binding Settings.TtsVoiceName}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=WindowsVoiceLabel}"/>
                            </Grid>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.TextToSpeechEngine}" Value="{x:Static models:TextToSpeechEngine.Piper}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Style="{StaticResource Row}" Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PiperVoiceLabel" Text="Piper voice" Style="{StaticResource RowLabel}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="PiperVoiceBox" Style="{StaticResource Field}"
                                                  ItemsSource="{Binding PiperModels}" SelectedItem="{Binding Settings.PiperVoiceModelFileName}"
                                                  IsEnabled="{Binding IsPiperAvailable}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=PiperVoiceLabel}"/>
                                        <ui:Button Content="Refresh" Style="{StaticResource Secondary}" Margin="8,0,0,0" Command="{Binding RefreshPiperModelsCommand}"
                                                   AutomationProperties.Name="Refresh Piper voices"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding PiperStatusText}" Style="{StaticResource Help}" Margin="220,0,0,10"/>
                            </StackPanel>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Speed" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="RateSlider" Grid.Column="1" Minimum="-10" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Value="{Binding Settings.TtsRate}" VerticalAlignment="Center" AutomationProperties.Name="Speed"/>
                                <TextBlock Grid.Column="2" Text="{Binding Settings.TtsRate}" Style="{StaticResource Unit}" Width="32" TextAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Volume" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Value="{Binding Settings.TtsVolume}" VerticalAlignment="Center" AutomationProperties.Name="Volume"/>
                                <TextBlock Grid.Column="2" Text="{Binding Settings.TtsVolume}" Style="{StaticResource Unit}" Width="32" TextAlignment="Right"/>
                            </Grid>
                            <StackPanel Style="{StaticResource Buttons}" Margin="220,0,0,8">
                                <ui:Button Content="Test voice" Style="{StaticResource Secondary}" Command="{Binding TestVoiceCommand}"/>
                            </StackPanel>

                            <Expander Header="Set up Piper" Margin="0,4,0,0" AutomationProperties.Name="Set up Piper">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Help}"
                                               Text="Piper is a free voice that runs on your computer and sounds more natural than the Windows one. Download Piper and extract the whole zip into the Piper folder, then download a voice: two files, for example en_US-lessac-medium.onnx and en_US-lessac-medium.onnx.json, into the same folder. Then click Refresh."/>
                                    <TextBlock Style="{StaticResource Help}"
                                               Text="It runs on the CPU, no graphics card needed, and nothing is sent anywhere. Its Windows build is a few years old but still works well for this."/>
                                    <StackPanel Style="{StaticResource Buttons}">
                                        <ui:Button Content="Download Piper..." Style="{StaticResource Secondary}" Command="{Binding OpenPiperEnginePageCommand}"/>
                                        <ui:Button Content="Download voices..." Style="{StaticResource Secondary}" Command="{Binding OpenPiperVoicePageCommand}"/>
                                        <ui:Button Content="Open Piper folder" Style="{StaticResource Secondary}" Command="{Binding OpenPiperModelsFolderCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Quick Reminder -->
                <StackPanel x:Name="QuickSection" Visibility="Collapsed" AutomationProperties.Name="Quick Reminder">
                    <TextBlock Text="Quick Reminder" Style="{StaticResource SectionTitle}"/>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="Shortcut" Style="{StaticResource GroupTitle}"/>
                            <CheckBox x:Name="HotkeyEnabledBox" Content="Open Quick Reminder with a keyboard shortcut" IsChecked="{Binding Settings.QuickAddHotkeyEnabled}"/>
                            <TextBlock Style="{StaticResource CheckHelp}" Margin="28,0,0,4" Text="Works from any app, so you can set a reminder without opening Pendulum."/>
                            <Grid Style="{StaticResource Row}" Margin="28,4,0,4" IsEnabled="{Binding Settings.QuickAddHotkeyEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="192"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Shortcut" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,10,0">
                                        <TextBlock x:Name="HotkeyText" Text="{Binding Settings.QuickAddHotkeyGesture}" FontFamily="Consolas"
                                                   AutomationProperties.Name="{Binding Settings.QuickAddHotkeyGesture, StringFormat=Shortcut: {0}}"/>
                                    </Border>
                                    <ui:Button Content="Change..." Appearance="Secondary" Command="{Binding ChangeHotkeyCommand}" AutomationProperties.Name="Change the shortcut"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="Speaking a reminder" Style="{StaticResource GroupTitle}"/>
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,8" Text="For the microphone button in Quick Reminder."/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SttEngineLabel" Text="Speech recognition" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="SttEngineBox" Grid.Column="1" Style="{StaticResource Field}"
                                          ItemsSource="{Binding SpeechToTextEngines}" SelectedItem="{Binding Settings.SpeechToTextEngine}"
                                          ItemTemplate="{StaticResource SttEngineName}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=SttEngineLabel}"/>
                            </Grid>

                            <!-- Whisper's model only with Whisper. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.SpeechToTextEngine}" Value="{x:Static models:SpeechToTextEngine.Whisper}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Style="{StaticResource Row}" Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WhisperModelLabel" Text="Whisper model" Style="{StaticResource RowLabel}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="WhisperModelBox" Style="{StaticResource Field}"
                                                  ItemsSource="{Binding WhisperModels}" SelectedItem="{Binding Settings.WhisperModelFileName}"
                                                  IsEnabled="{Binding IsWhisperAvailable}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=WhisperModelLabel}"/>
                                        <ui:Button Content="Refresh" Style="{StaticResource Secondary}" Margin="8,0,0,0" Command="{Binding RefreshWhisperModelsCommand}"
                                                   AutomationProperties.Name="Refresh Whisper models"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding WhisperStatusText}" Style="{StaticResource Help}" Margin="220,0,0,10"/>
                            </StackPanel>

                            <CheckBox x:Name="AutoListenBox" Content="Start listening as soon as Quick Reminder opens" IsChecked="{Binding Settings.QuickAddAutoListen}" Margin="0,4,0,8"/>

                            <Expander Header="Set up Whisper" Margin="0,4,0,0" AutomationProperties.Name="Set up Whisper">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Help}"
                                               Text="Whisper is free speech recognition that runs on your computer and is usually far more accurate with accents than the Windows one. Download a model (a .bin file) into the Whisper folder, then click Refresh. Names ending in .en, like ggml-base.en.bin, are English only; the others are multilingual. The base and small models are a good balance of speed and accuracy."/>
                                    <TextBlock Style="{StaticResource Help}"
                                               Text="It runs on the CPU, no graphics card needed, only while it listens, and nothing is sent anywhere."/>
                                    <StackPanel Style="{StaticResource Buttons}">
                                        <ui:Button Content="Download models..." Style="{StaticResource Secondary}" Command="{Binding OpenWhisperModelPageCommand}"/>
                                        <ui:Button Content="Open Whisper folder" Style="{StaticResource Secondary}" Command="{Binding OpenWhisperModelsFolderCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Backup and data -->
                <StackPanel x:Name="DataSection" Visibility="Collapsed" AutomationProperties.Name="Backup and data">
                    <TextBlock Text="Backup and data" Style="{StaticResource SectionTitle}"/>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="Spent reminders" Style="{StaticResource GroupTitle}"/>
                            <Grid Style="{StaticResource Row}" Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Delete spent reminders after" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:TextBox x:Name="AutoDeleteBox" Style="{StaticResource Number}" MaxLength="4"
                                                Text="{Binding Settings.AutoDeleteSpentAfterDays, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="Delete spent reminders after, days"/>
                                    <TextBlock Text="days" Style="{StaticResource Unit}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,4"
                                       Text="A spent reminder is a one-off that has already gone off. They're deleted when Pendulum starts; 0 keeps them."/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="Backup" Style="{StaticResource GroupTitle}"/>
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,10"
                                       Text="Saves every setting and reminder to one file, to move Pendulum to another computer or keep a copy."/>
                            <StackPanel Style="{StaticResource Buttons}">
                                <ui:Button Content="Back up..." Style="{StaticResource Secondary}" Command="{Binding ExportBackupCommand}" AutomationProperties.Name="Back up settings and reminders"/>
                                <ui:Button Content="Restore..." Style="{StaticResource Secondary}" Command="{Binding RestoreBackupCommand}" AutomationProperties.Name="Restore a backup"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="Reset" Style="{StaticResource GroupTitle}"/>
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,10"
                                       Text="Puts every setting in these sections back to its default. Your reminders aren't touched."/>
                            <StackPanel Style="{StaticResource Buttons}">
                                <ui:Button Content="Reset settings..." Style="{StaticResource Secondary}" Command="{Binding ResetToDefaultsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
