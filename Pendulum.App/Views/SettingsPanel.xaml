<UserControl x:Class="Pendulum.App.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Pendulum.App.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pendulum.App.ViewModels"
             xmlns:conv="clr-namespace:Pendulum.App.Converters"
             xmlns:models="clr-namespace:Pendulum.Core.Models;assembly=Pendulum.Core">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:EnumSpacedDisplayConverter x:Key="EnumSpaced"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- A section's title, a group's title, a row's label and a help line. -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,12"/>
        </Style>
        <!-- Help under a check box lines up with the box's text. -->
        <Style x:Key="CheckHelp" TargetType="TextBlock" BasedOn="{StaticResource Help}">
            <Setter Property="Margin" Value="28,0,0,12"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style x:Key="Group" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Field" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="260"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Number" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Width" Value="64"/>
            <Setter Property="ClearButtonEnabled" Value="False"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="Buttons" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Secondary" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <GridLength x:Key="LabelWidth">220</GridLength>

        <!-- The engines by plain names (the saved values stay the enum's). -->
        <DataTemplate x:Key="TtsEngineName">
            <TextBlock x:Name="Name" Text="{x:Static res:Strings.Settings_WindowsBuiltIn}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static models:TextToSpeechEngine.Piper}">
                    <Setter TargetName="Name" Property="Text" Value="{x:Static res:Strings.Settings_PiperOfflineMoreNatural}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="SttEngineName">
            <TextBlock x:Name="Name" Text="{x:Static res:Strings.Settings_WindowsBuiltIn}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static models:SpeechToTextEngine.Whisper}">
                    <Setter TargetName="Name" Property="Text" Value="{x:Static res:Strings.Settings_WhisperOfflineMoreAccurate}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The section list: the selected one tinted with a bar in the accent, as the main tabs are. -->
        <Style x:Key="SectionItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0,9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" Background="Transparent" Margin="2,0,10,0"/>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="14"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PendulumAccentSoftBrush}"/>
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource PendulumAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1040" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Text="{x:Static res:Strings.Settings_Settings}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBlock Text="{x:Static res:Strings.Settings_ChooseASectionOnTheLeft}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Arrow keys move between sections; Tab moves into the section shown. -->
        <ListBox x:Name="SectionList" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" BorderThickness="0" Background="Transparent"
                 ItemContainerStyle="{StaticResource SectionItem}" SelectedIndex="0" SelectionChanged="SectionList_SelectionChanged"
                 AutomationProperties.Name="{x:Static res:Strings.Settings_SettingsSections}" KeyboardNavigation.TabNavigation="Once">
            <ListBoxItem Content="{x:Static res:Strings.Settings_General}" Tag="&#xE713;" AutomationProperties.Name="{x:Static res:Strings.Settings_General}"/>
            <ListBoxItem Content="{x:Static res:Strings.Settings_Alerts}" Tag="&#xE7BA;" AutomationProperties.Name="{x:Static res:Strings.Settings_Alerts}"/>
            <ListBoxItem Content="{x:Static res:Strings.Settings_SpokenAlerts}" Tag="&#xE767;" AutomationProperties.Name="{x:Static res:Strings.Settings_SpokenAlerts}"/>
            <ListBoxItem Content="{x:Static res:Strings.Settings_QuickReminder}" Tag="&#xE720;" AutomationProperties.Name="{x:Static res:Strings.Settings_QuickReminder}"/>
            <ListBoxItem Content="{x:Static res:Strings.Settings_BackupAndData}" Tag="&#xE74E;" AutomationProperties.Name="{x:Static res:Strings.Settings_BackupAndData}"/>
        </ListBox>

        <ScrollViewer x:Name="SectionScroller" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Grid MaxWidth="760" HorizontalAlignment="Stretch" Margin="0,0,12,4">

                <!-- General -->
                <StackPanel x:Name="GeneralSection" AutomationProperties.Name="{x:Static res:Strings.Settings_General}">
                    <TextBlock Text="{x:Static res:Strings.Settings_General}" Style="{StaticResource SectionTitle}"/>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="{x:Static res:Strings.Settings_WhenPendulumStarts}" Style="{StaticResource GroupTitle}"/>
                            <CheckBox x:Name="LaunchOnStartupBox" Content="{x:Static res:Strings.Settings_StartWithWindows}" IsChecked="{Binding Settings.LaunchOnWindowsStartup}"/>
                            <TextBlock Style="{StaticResource CheckHelp}" Text="{x:Static res:Strings.Settings_PendulumOpensWhenYouSignInSoYourRemindersGoOffEv}"/>
                            <CheckBox x:Name="StartMinimizedBox" Content="{x:Static res:Strings.Settings_StartInTheTray}" IsChecked="{Binding Settings.StartMinimized}"/>
                            <TextBlock Style="{StaticResource CheckHelp}" Text="{x:Static res:Strings.Settings_OpensHiddenInTheNotificationAreaInsteadOfShowing}"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="{x:Static res:Strings.Settings_Appearance}" Style="{StaticResource GroupTitle}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ThemeLabel" Text="{x:Static res:Strings.Settings_Theme}" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="ThemeBox" Grid.Column="1" Style="{StaticResource Field}" Width="200"
                                          ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding Settings.Theme}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumSpaced}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TimeFormatLabel" Text="{x:Static res:Strings.Settings_TimeFormat}" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="TimeFormatBox" Grid.Column="1" Style="{StaticResource Field}" Width="200" SelectedIndex="{Binding TimeFormatIndex}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=TimeFormatLabel}">
                                    <ComboBoxItem Content="{x:Static res:Strings.Settings_12Hour230PM}"/>
                                    <ComboBoxItem Content="{x:Static res:Strings.Settings_24Hour1430}"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="{x:Static res:Strings.Settings_Updates}" Style="{StaticResource GroupTitle}"/>
                            <CheckBox x:Name="UpdateCheckBox" Content="{x:Static res:Strings.Settings_CheckForUpdatesWhenPendulumStarts}" IsChecked="{Binding Settings.CheckForUpdatesOnStartup}"/>
                            <TextBlock Style="{StaticResource CheckHelp}" Margin="28,0,0,4"
                                       Text="{x:Static res:Strings.Settings_OffUnlessYouTurnItOnWhenPendulumStartsItAsksGitH}"/>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Alerts -->
                <StackPanel x:Name="AlertsSection" Visibility="Collapsed" AutomationProperties.Name="{x:Static res:Strings.Settings_Alerts}">
                    <TextBlock Text="{x:Static res:Strings.Settings_Alerts}" Style="{StaticResource SectionTitle}"/>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="{x:Static res:Strings.Settings_Sound}" Style="{StaticResource GroupTitle}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DefaultSoundLabel" Text="{x:Static res:Strings.Settings_SoundForNewReminders}" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="DefaultSoundBox" Grid.Column="1" Style="{StaticResource Field}" Width="200"
                                          ItemsSource="{Binding SoundFiles}" SelectedItem="{Binding Settings.DefaultSoundFileName}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=DefaultSoundLabel}"/>
                            </Grid>
                            <StackPanel Style="{StaticResource Buttons}" Margin="220,0,0,4">
                                <ui:Button Content="{x:Static res:Strings.Settings_AddSound}" Style="{StaticResource Secondary}" Command="{Binding AddSoundCommand}"/>
                                <ui:Button Content="{x:Static res:Strings.Settings_OpenSoundsFolder}" Style="{StaticResource Secondary}" Command="{Binding OpenSoundsFolderCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="{x:Static res:Strings.Settings_WhenAnAlertAppears}" Style="{StaticResource GroupTitle}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SnoozeLabel" Text="{x:Static res:Strings.Settings_SnoozeFor}" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:TextBox x:Name="SnoozeBox" Style="{StaticResource Number}" MaxLength="3"
                                                Text="{Binding Settings.SnoozeMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Static res:Strings.Settings_SnoozeForMinutes}"/>
                                    <TextBlock Text="{x:Static res:Strings.Settings_Minutes}" Style="{StaticResource Unit}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="RepeatBox" Content="{x:Static res:Strings.Settings_KeepAlertingUntilIDismissIt}" IsChecked="{Binding Settings.RepeatAlertUntilDismissed}"/>
                            <Grid Style="{StaticResource Row}" Margin="28,8,0,4"
                                  IsEnabled="{Binding Settings.RepeatAlertUntilDismissed, Converter={StaticResource InverseBool}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="192"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.Settings_OtherwiseDismissItAfter}" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:TextBox x:Name="AutoResolveBox" Style="{StaticResource Number}" MaxLength="3"
                                                Text="{Binding Settings.AutoResolveMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Static res:Strings.Settings_OtherwiseDismissItAfterMinutes}"/>
                                    <TextBlock Text="{x:Static res:Strings.Settings_Minutes}" Style="{StaticResource Unit}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource CheckHelp}" Margin="28,0,0,4"
                                       Text="{x:Static res:Strings.Settings_UsedOnlyWhenAlertsDontKeepGoingAnUnansweredAlert}"/>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Spoken alerts -->
                <StackPanel x:Name="VoiceSection" Visibility="Collapsed" AutomationProperties.Name="{x:Static res:Strings.Settings_SpokenAlerts}">
                    <TextBlock Text="{x:Static res:Strings.Settings_SpokenAlerts}" Style="{StaticResource SectionTitle}"/>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="{x:Static res:Strings.Settings_Voice}" Style="{StaticResource GroupTitle}"/>
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,8" Text="{x:Static res:Strings.Settings_UsedForRemindersSetToSpeakAndForTestVoice}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TtsEngineLabel" Text="{x:Static res:Strings.Settings_SpeechEngine}" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="TtsEngineBox" Grid.Column="1" Style="{StaticResource Field}"
                                          ItemsSource="{Binding TextToSpeechEngines}" SelectedItem="{Binding Settings.TextToSpeechEngine}"
                                          ItemTemplate="{StaticResource TtsEngineName}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=TtsEngineLabel}"/>
                            </Grid>

                            <!-- Only the chosen engine's voices. -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource Row}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.TextToSpeechEngine}" Value="{x:Static models:TextToSpeechEngine.Piper}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="WindowsVoiceLabel" Text="{x:Static res:Strings.Settings_WindowsVoice}" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="WindowsVoiceBox" Grid.Column="1" Style="{StaticResource Field}"
                                          ItemsSource="{Binding VoiceNames}" SelectedItem="{Binding Settings.TtsVoiceName}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=WindowsVoiceLabel}"/>
                            </Grid>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.TextToSpeechEngine}" Value="{x:Static models:TextToSpeechEngine.Piper}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Style="{StaticResource Row}" Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PiperVoiceLabel" Text="{x:Static res:Strings.Settings_PiperVoice}" Style="{StaticResource RowLabel}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="PiperVoiceBox" Style="{StaticResource Field}"
                                                  ItemsSource="{Binding PiperModels}" SelectedItem="{Binding Settings.PiperVoiceModelFileName}"
                                                  IsEnabled="{Binding IsPiperAvailable}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=PiperVoiceLabel}"/>
                                        <ui:Button Content="{x:Static res:Strings.Settings_Refresh}" Style="{StaticResource Secondary}" Margin="8,0,0,0" Command="{Binding RefreshPiperModelsCommand}"
                                                   AutomationProperties.Name="{x:Static res:Strings.Settings_RefreshPiperVoices}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding PiperStatusText}" Style="{StaticResource Help}" Margin="220,0,0,10"/>
                            </StackPanel>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.Settings_Speed}" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="RateSlider" Grid.Column="1" Minimum="-10" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Value="{Binding Settings.TtsRate}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static res:Strings.Settings_Speed}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Settings.TtsRate}" Style="{StaticResource Unit}" Width="32" TextAlignment="Right"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.Settings_Volume}" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Value="{Binding Settings.TtsVolume}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static res:Strings.Settings_Volume}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Settings.TtsVolume}" Style="{StaticResource Unit}" Width="32" TextAlignment="Right"/>
                            </Grid>
                            <StackPanel Style="{StaticResource Buttons}" Margin="220,0,0,8">
                                <ui:Button Content="{x:Static res:Strings.Settings_TestVoice}" Style="{StaticResource Secondary}" Command="{Binding TestVoiceCommand}"/>
                            </StackPanel>

                            <Expander Header="{x:Static res:Strings.Settings_SetUpPiper}" Margin="0,4,0,0" AutomationProperties.Name="{x:Static res:Strings.Settings_SetUpPiper}">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Help}"
                                               Text="{x:Static res:Strings.Settings_PiperIsAFreeVoiceThatRunsOnYourComputerAndSounds}"/>
                                    <TextBlock Style="{StaticResource Help}"
                                               Text="{x:Static res:Strings.Settings_ItRunsOnTheCPUNoGraphicsCardNeededAndNothingIsSe}"/>
                                    <StackPanel Style="{StaticResource Buttons}" Margin="0,0,0,2">
                                        <ui:Button Content="{x:Static res:Strings.Settings_DownloadPiper}" Style="{StaticResource Secondary}" Command="{Binding OpenPiperEnginePageCommand}"/>
                                        <ui:Button Content="{x:Static res:Strings.Settings_OpenPiperFolder}" Style="{StaticResource Secondary}" Command="{Binding OpenPiperModelsFolderCommand}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Help}" Text="{x:Static res:Strings.Settings_PiperLicence}"/>

                                    <!-- Only the voices whose terms let anyone use them, each with its licence and credit. -->
                                    <TextBlock Text="{x:Static res:Strings.Settings_VoicesHeading}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,6"/>
                                    <ItemsControl x:Name="VoiceOffers" ItemsSource="{Binding PiperVoiceOffers}" Focusable="False"
                                                  AutomationProperties.Name="{x:Static res:Strings.Settings_VoicesHeading}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                        <TextBlock Text="{Binding Licence}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Credit}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <ui:Button Grid.Column="1" Content="{x:Static res:Strings.Settings_DownloadVoice}" Appearance="Secondary" VerticalAlignment="Center"
                                                               Command="{Binding DataContext.OpenVoicePageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.Settings_DownloadVoiceNameFormat}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Quick Reminder -->
                <StackPanel x:Name="QuickSection" Visibility="Collapsed" AutomationProperties.Name="{x:Static res:Strings.Settings_QuickReminder}">
                    <TextBlock Text="{x:Static res:Strings.Settings_QuickReminder}" Style="{StaticResource SectionTitle}"/>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="{x:Static res:Strings.Settings_Shortcut}" Style="{StaticResource GroupTitle}"/>
                            <CheckBox x:Name="HotkeyEnabledBox" Content="{x:Static res:Strings.Settings_OpenQuickReminderWithAKeyboardShortcut}" IsChecked="{Binding Settings.QuickAddHotkeyEnabled}"/>
                            <TextBlock Style="{StaticResource CheckHelp}" Margin="28,0,0,4" Text="{x:Static res:Strings.Settings_WorksFromAnyAppSoYouCanSetAReminderWithoutOpenin}"/>
                            <Grid Style="{StaticResource Row}" Margin="28,4,0,4" IsEnabled="{Binding Settings.QuickAddHotkeyEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="192"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.Settings_Shortcut}" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,10,0">
                                        <TextBlock x:Name="HotkeyText" Text="{Binding Settings.QuickAddHotkeyGesture}" FontFamily="Consolas"
                                                   AutomationProperties.Name="{Binding Settings.QuickAddHotkeyGesture, StringFormat={x:Static res:Strings.Settings_ShortcutNameFormat}}"/>
                                    </Border>
                                    <ui:Button Content="{x:Static res:Strings.Settings_Change}" Appearance="Secondary" Command="{Binding ChangeHotkeyCommand}" AutomationProperties.Name="{x:Static res:Strings.Settings_ChangeTheShortcut}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="{x:Static res:Strings.Settings_SpeakingAReminder}" Style="{StaticResource GroupTitle}"/>
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,8" Text="{x:Static res:Strings.Settings_ForTheMicrophoneButtonInQuickReminder}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SttEngineLabel" Text="{x:Static res:Strings.Settings_SpeechRecognition}" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="SttEngineBox" Grid.Column="1" Style="{StaticResource Field}"
                                          ItemsSource="{Binding SpeechToTextEngines}" SelectedItem="{Binding Settings.SpeechToTextEngine}"
                                          ItemTemplate="{StaticResource SttEngineName}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=SttEngineLabel}"/>
                            </Grid>

                            <!-- Whisper's model only with Whisper. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.SpeechToTextEngine}" Value="{x:Static models:SpeechToTextEngine.Whisper}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Style="{StaticResource Row}" Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WhisperModelLabel" Text="{x:Static res:Strings.Settings_WhisperModel}" Style="{StaticResource RowLabel}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="WhisperModelBox" Style="{StaticResource Field}"
                                                  ItemsSource="{Binding WhisperModels}" SelectedItem="{Binding Settings.WhisperModelFileName}"
                                                  IsEnabled="{Binding IsWhisperAvailable}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=WhisperModelLabel}"/>
                                        <ui:Button Content="{x:Static res:Strings.Settings_Refresh}" Style="{StaticResource Secondary}" Margin="8,0,0,0" Command="{Binding RefreshWhisperModelsCommand}"
                                                   AutomationProperties.Name="{x:Static res:Strings.Settings_RefreshWhisperModels}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding WhisperStatusText}" Style="{StaticResource Help}" Margin="220,0,0,10"/>
                            </StackPanel>

                            <CheckBox x:Name="AutoListenBox" Content="{x:Static res:Strings.Settings_StartListeningAsSoonAsQuickReminderOpens}" IsChecked="{Binding Settings.QuickAddAutoListen}" Margin="0,4,0,8"/>

                            <Expander Header="{x:Static res:Strings.Settings_SetUpWhisper}" Margin="0,4,0,0" AutomationProperties.Name="{x:Static res:Strings.Settings_SetUpWhisper}">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Help}"
                                               Text="{x:Static res:Strings.Settings_WhisperIsFreeSpeechRecognitionThatRunsOnYourComp}"/>
                                    <TextBlock Style="{StaticResource Help}"
                                               Text="{x:Static res:Strings.Settings_ItRunsOnTheCPUNoGraphicsCardNeededOnlyWhileItLis}"/>
                                    <StackPanel Style="{StaticResource Buttons}">
                                        <ui:Button Content="{x:Static res:Strings.Settings_DownloadModels}" Style="{StaticResource Secondary}" Command="{Binding OpenWhisperModelPageCommand}"/>
                                        <ui:Button Content="{x:Static res:Strings.Settings_OpenWhisperFolder}" Style="{StaticResource Secondary}" Command="{Binding OpenWhisperModelsFolderCommand}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Help}" Margin="0,6,0,0" Text="{x:Static res:Strings.Settings_WhisperLicence}"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- Backup and data -->
                <StackPanel x:Name="DataSection" Visibility="Collapsed" AutomationProperties.Name="{x:Static res:Strings.Settings_BackupAndData}">
                    <TextBlock Text="{x:Static res:Strings.Settings_BackupAndData}" Style="{StaticResource SectionTitle}"/>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="{x:Static res:Strings.Settings_SpentReminders}" Style="{StaticResource GroupTitle}"/>
                            <Grid Style="{StaticResource Row}" Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.Settings_DeleteSpentRemindersAfter}" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:TextBox x:Name="AutoDeleteBox" Style="{StaticResource Number}" MaxLength="4"
                                                Text="{Binding Settings.AutoDeleteSpentAfterDays, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Static res:Strings.Settings_DeleteSpentRemindersAfterDays}"/>
                                    <TextBlock Text="{x:Static res:Strings.Settings_Days}" Style="{StaticResource Unit}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,4"
                                       Text="{x:Static res:Strings.Settings_ASpentReminderIsAOneOffThatHasAlreadyGoneOffThey}"/>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="{x:Static res:Strings.Settings_Backup}" Style="{StaticResource GroupTitle}"/>
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,10"
                                       Text="{x:Static res:Strings.Settings_SavesEverySettingAndReminderToOneFileToMovePendu}"/>
                            <StackPanel Style="{StaticResource Buttons}">
                                <ui:Button Content="{x:Static res:Strings.Settings_BackUpButton}" Style="{StaticResource Secondary}" Command="{Binding ExportBackupCommand}" AutomationProperties.Name="{x:Static res:Strings.Settings_BackUpSettingsAndReminders}"/>
                                <ui:Button Content="{x:Static res:Strings.Settings_Restore}" Style="{StaticResource Secondary}" Command="{Binding RestoreBackupCommand}" AutomationProperties.Name="{x:Static res:Strings.Settings_RestoreABackup}"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                    <ui:Card Style="{StaticResource Group}">
                        <StackPanel Margin="4">
                            <TextBlock Text="{x:Static res:Strings.Settings_Reset}" Style="{StaticResource GroupTitle}"/>
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,10"
                                       Text="{x:Static res:Strings.Settings_PutsEverySettingInTheseSectionsBackToItsDefaultY}"/>
                            <StackPanel Style="{StaticResource Buttons}">
                                <ui:Button Content="{x:Static res:Strings.Settings_ResetSettings}" Style="{StaticResource Secondary}" Command="{Binding ResetToDefaultsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
