<UserControl x:Class="Pendulum.App.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pendulum.App.ViewModels"
             xmlns:conv="clr-namespace:Pendulum.App.Converters">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:EnumSpacedDisplayConverter x:Key="EnumSpaced"/>
        <Style x:Key="SectionHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabelInline" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="FieldCombo" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="56"/>
        </Style>

        <!-- Each section's label column width is independent — tweak one without affecting the others. -->
        <GridLength x:Key="GeneralLabelWidth">200</GridLength>
        <GridLength x:Key="RemindersLabelWidth">200</GridLength>
        <GridLength x:Key="SoundsLabelWidth">200</GridLength>
        <GridLength x:Key="TtsLabelWidth">200</GridLength>
        <GridLength x:Key="SttLabelWidth">110</GridLength>
    </UserControl.Resources>

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Width="{Binding ActualWidth, ElementName=RootScrollViewer}" MaxWidth="920" HorizontalAlignment="Center" Margin="0,0,0,4">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2"/>
        <TextBlock Text="Configure sounds, speech, and alert behavior." FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <ui:Card Margin="0,0,0,10">
                    <StackPanel Margin="4">
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="General" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox Content="Launch on Windows startup" IsChecked="{Binding Settings.LaunchOnWindowsStartup}" Margin="0,0,20,0"/>
                            <CheckBox Content="Start minimized" IsChecked="{Binding Settings.StartMinimized}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource GeneralLabelWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Theme" Style="{StaticResource FieldLabelInline}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding Settings.Theme}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumSpaced}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,10">
                    <StackPanel Margin="4">
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Reminders" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource RemindersLabelWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Time format" Style="{StaticResource FieldLabelInline}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" SelectedIndex="{Binding TimeFormatIndex}">
                                <ComboBoxItem Content="12-hour (AM/PM)"/>
                                <ComboBoxItem Content="24-hour"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox Content="Enable quick-add hotkey" IsChecked="{Binding Settings.QuickAddHotkeyEnabled}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource RemindersLabelWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Quick-add hotkey" Style="{StaticResource FieldLabelInline}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Settings.QuickAddHotkeyGesture}" FontFamily="Consolas"/>
                                </Border>
                                <ui:Button Content="Change..." Appearance="Secondary" Command="{Binding ChangeHotkeyCommand}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Auto-delete spent reminders after (days, 0 = never)" Style="{StaticResource FieldLabelInline}"/>
                            <ui:TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" HorizontalAlignment="Stretch" MaxLength="4" ClearButtonEnabled="False"
                                        Text="{Binding Settings.AutoDeleteSpentAfterDays, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,10">
                    <StackPanel Margin="4">
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Alerts" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Snooze duration (minutes)" Style="{StaticResource FieldLabelInline}"/>
                            <ui:TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" HorizontalAlignment="Stretch" MaxLength="3" ClearButtonEnabled="False" Text="{Binding Settings.SnoozeMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <CheckBox Content="Repeat alert until dismissed" IsChecked="{Binding Settings.RepeatAlertUntilDismissed}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Auto-resolve after (minutes), when not repeating" Style="{StaticResource FieldLabelInline}"/>
                            <ui:TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}" HorizontalAlignment="Stretch" MaxLength="3" ClearButtonEnabled="False"
                                        Text="{Binding Settings.AutoResolveMinutes, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding Settings.RepeatAlertUntilDismissed, Converter={StaticResource InverseBool}}"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,10">
                    <StackPanel Margin="4">
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Backup &amp; Restore" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Text="Back up all settings and reminders to a file — everything you need to move Pendulum to another computer." Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Export Backup..." Appearance="Secondary" Command="{Binding ExportBackupCommand}" Margin="0,0,10,0"/>
                            <ui:Button Content="Restore Backup..." Appearance="Secondary" Command="{Binding RestoreBackupCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Card>
                    <StackPanel Margin="4">
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Reset" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Text="Restore all settings on this page to their original defaults. Your reminders are not affected." Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <ui:Button Content="Reset to Defaults" Appearance="Secondary" HorizontalAlignment="Left"
                                   Command="{Binding ResetToDefaultsCommand}"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <ui:Card Margin="0,0,0,10">
                    <StackPanel Margin="4">
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Speech-to-Text" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Text="Used by the microphone button in Quick Reminder." Style="{StaticResource FieldLabel}"/>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource SttLabelWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Engine" Style="{StaticResource FieldLabelInline}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" ItemsSource="{Binding SpeechToTextEngines}" SelectedItem="{Binding Settings.SpeechToTextEngine}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumSpaced}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource SttLabelWidth}"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Whisper model" Style="{StaticResource FieldLabelInline}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" Margin="0,0,8,0"
                                      ItemsSource="{Binding WhisperModels}" SelectedItem="{Binding Settings.WhisperModelFileName}"
                                      IsEnabled="{Binding IsWhisperAvailable}"/>
                            <ui:Button Grid.Column="2" Content="Refresh" Appearance="Secondary" Command="{Binding RefreshWhisperModelsCommand}"/>
                        </Grid>

                        <TextBlock Text="{Binding WhisperStatusText}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}">
                            Whisper runs fully offline and is usually far more accurate with accents than Windows'
                            built-in recognizer. To use it: download a .bin model file below (names ending in
                            ".en", e.g. ggml-base.en.bin, are English-only; names with no suffix, e.g.
                            ggml-base.bin, are multilingual), then drop it into the Whisper Models folder and
                            click Refresh. The "base" or "small" models are a good balance of speed and accuracy —
                            larger models are slower and use more memory for little benefit on short phrases.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Margin="0,4,0,10">
                            Runs on CPU (no GPU needed) — briefly uses CPU while transcribing, but sits idle
                            otherwise, so it's not a background drain.
                        </TextBlock>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Download Models..." Appearance="Secondary" Command="{Binding OpenWhisperModelPageCommand}" Margin="0,0,10,0"/>
                            <ui:Button Content="Open Models Folder" Appearance="Secondary" Command="{Binding OpenWhisperModelsFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,10">
                    <StackPanel Margin="4">
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Text="&#xE8AF;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Text-to-Speech" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource TtsLabelWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Voice" Style="{StaticResource FieldLabelInline}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" ItemsSource="{Binding VoiceNames}" SelectedItem="{Binding Settings.TtsVoiceName}"/>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource TtsLabelWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rate" Style="{StaticResource FieldLabelInline}"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="-10" Maximum="10" Value="{Binding Settings.TtsRate}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Settings.TtsRate}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" Width="24" TextAlignment="Right"/>
                            </Grid>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource TtsLabelWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Volume" Style="{StaticResource FieldLabelInline}"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Settings.TtsVolume}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Settings.TtsVolume}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" Width="24" TextAlignment="Right"/>
                            </Grid>
                        </Grid>

                        <ui:Button Content="Test Voice" Appearance="Secondary" Command="{Binding TestVoiceCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ui:Card>

                <ui:Card>
                    <StackPanel Margin="4">
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Margin="0,0,10,0"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Sounds" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource SoundsLabelWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Default sound for new timers" Style="{StaticResource FieldLabelInline}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource FieldCombo}" ItemsSource="{Binding SoundFiles}" SelectedItem="{Binding Settings.DefaultSoundFileName}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Content="Open Sounds Folder" Appearance="Secondary" Command="{Binding OpenSoundsFolderCommand}"/>
                            <ui:Button Grid.Column="1" Content="Add Sound..." Appearance="Secondary" Command="{Binding AddSoundCommand}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>
    </StackPanel>
    </ScrollViewer>
</UserControl>
