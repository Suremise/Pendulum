<ui:FluentWindow x:Class="Pendulum.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="About Pendulum"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="About Pendulum" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="28,4,28,28">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Image Source="pack://application:,,,/Resources/pendulum.ico" Width="48" Height="48" Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pendulum" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Text="Version 1.0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,18" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                Pendulum is a tray-resident desktop timer and alarm utility. It stays
                out of the way in the system tray and surfaces alerts as a topmost
                popup with sound and/or spoken-phrase notifications, even while
                you're working in another window.
            </TextBlock>

            <ui:Card Margin="0,0,0,18">
                <StackPanel Margin="4">
                    <TextBlock Text="PANELS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>

                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="Reminders" Margin="0,0,0,2"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10">
                        Alarms that fire at an exact date and time, with a choice of sound,
                        spoken phrase, or both, and an adjustable per-timer volume.
                    </TextBlock>

                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="Settings" Margin="0,0,0,2"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                        Manage the sound library, text-to-speech voice/rate/volume, alert
                        style and snooze behavior, 12/24-hour time format, and whether
                        Pendulum launches with Windows.
                    </TextBlock>
                </StackPanel>
            </ui:Card>

            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2">
                <Run Text="Author: "/><Run Text="" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10">
                <Run Text="Contributors: "/><Run Text="Claude (Sonnet 5)" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap">
                <Run Text="Surmise Software" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="Sure" FontWeight="Bold"/><Run Text="mised it right. — "/><Hyperlink NavigateUri="https://surmise.it" RequestNavigate="Hyperlink_RequestNavigate">surmise.it</Hyperlink>
            </TextBlock>

            <ui:Button Content="Close" Appearance="Primary" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
