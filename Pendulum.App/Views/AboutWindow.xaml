<ui:FluentWindow x:Class="Pendulum.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Pendulum.App.Views"
        Title="About Pendulum"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="About Pendulum" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="28,4,28,24">

            <!-- The icon and the name, then the tagline. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Image Source="pack://application:,,,/Resources/pendulum.ico" Width="56" Height="56" Margin="0,0,16,0"/>
                <TextBlock Text="Pendulum" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="A timer and alarm utility that waits in the tray and pops up over whatever you're working in, with a sound or a spoken phrase."/>

            <!-- The facts a bug report needs; Copy puts them on the clipboard. -->
            <ItemsControl x:Name="FactsList" Margin="0,0,0,16" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                <Run Text="Open source under the "/><Hyperlink Click="LicenseButton_Click">MIT License</Hyperlink><Run Text=". Includes "/><Hyperlink Click="ThirdPartyNoticesButton_Click">third-party software</Hyperlink><Run Text="."/>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="No telemetry. Pendulum goes online only to check for updates, and only when that's turned on in Settings."/>
            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20"
                       Text="© 2026 Darren Marshall."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CopyButton" Content="Copy" Margin="0,0,8,0" Click="CopyButton_Click"
                           ToolTip="Copy the version information, for a bug report"/>
                <ui:Button Content="Release notes" Margin="0,0,8,0" Click="ReleaseNotesButton_Click"
                           ToolTip="{x:Static local:AboutLinks.Releases}"/>
                <ui:Button Content="Source code" Margin="0,0,8,0" Click="SourceCodeButton_Click"
                           ToolTip="{x:Static local:AboutLinks.Repository}"/>
                <ui:Button Content="OK" Appearance="Primary" IsDefault="True" IsCancel="True" Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
