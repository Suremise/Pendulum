<Window x:Class="Pendulum.App.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Pendulum"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual">
    <Border Background="#FF201F36"
            CornerRadius="12"
            BorderBrush="#FF544399"
            BorderThickness="1.5"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Image Source="pack://application:,,,/Resources/pendulum.ico" Width="18" Height="18" Margin="0,0,9,0"/>
                <TextBlock Text="PENDULUM" FontSize="11" FontWeight="Bold" Foreground="#FFA9A6D0" VerticalAlignment="Center"
                           TextOptions.TextFormattingMode="Ideal" Padding="0,1,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TitleText" Text="Timer" FontSize="21" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock x:Name="SubtitleText" Text="" FontSize="13" Foreground="#FFCFCDE6" TextWrapping="Wrap" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="SnoozeButton" Content="Snooze" Appearance="Secondary" Margin="0,0,10,0" Click="SnoozeButton_Click"/>
                <ui:Button x:Name="DismissButton" Content="Dismiss" Appearance="Primary" Click="DismissButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
