<Window x:Class="Pendulum.App.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Pendulum.App.Resources"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{x:Static res:Strings.App_Name}"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual">
    <Border Background="#FF2A1720"
            CornerRadius="12"
            BorderBrush="#FF8E3A58"
            BorderThickness="1.5"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Image Source="pack://application:,,,/Resources/pendulum.ico" Width="18" Height="18" Margin="0,0,9,0"/>
                <TextBlock Text="{x:Static res:Strings.Alert_AppNameHeading}" FontSize="11" FontWeight="Bold" Foreground="#FFE3A9BD" VerticalAlignment="Center"
                           TextOptions.TextFormattingMode="Ideal" Padding="0,1,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TitleText" Text="" FontSize="21" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock x:Name="SubtitleText" Text="" FontSize="13" Foreground="#FFEBD3DC" TextWrapping="Wrap" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="SnoozeButton" Content="{x:Static res:Strings.Alert_Snooze}" Appearance="Secondary" Margin="0,0,10,0" Click="SnoozeButton_Click"/>
                <ui:Button x:Name="DismissButton" Content="{x:Static res:Strings.Alert_Dismiss}" Appearance="Primary" Click="DismissButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
