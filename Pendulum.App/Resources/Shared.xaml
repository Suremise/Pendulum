<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:res="clr-namespace:Pendulum.App.Resources"
                    xmlns:models="clr-namespace:Pendulum.Core.Models;assembly=Pendulum.Core"
                    xmlns:conv="clr-namespace:Pendulum.App.Converters"
                    xmlns:controls="clr-namespace:Pendulum.App.Controls"
                    xmlns:services="clr-namespace:Pendulum.App.Services">
    <!-- Pendulum's brushes are set by AppThemeManager before any window opens. -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource PendulumLinkBrush}"/>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:DateTimeDisplayConverter x:Key="DateTimeDisplay"/>
    <conv:InverseBooleanConverter x:Key="InverseBool"/>
    <conv:EnumSpacedDisplayConverter x:Key="EnumSpaced"/>
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    <conv:SortArrowConverter x:Key="SortArrow"/>
    <conv:BoolToSelectColumnWidthConverter x:Key="SelectColumnWidth"/>
    <conv:NullToVisibilityConverter x:Key="ScheduledVis"/>
    <conv:InverseNullToVisibilityConverter x:Key="FixedVis"/>
    <conv:ReminderStatusVisibilityConverter x:Key="ReminderStatusVis"/>

    <Style x:Key="BadgeBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <Style x:Key="TagBadge" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,0,6,2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
    </Style>

    <Style x:Key="TagBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="RowBadgeText" TargetType="TextBlock" BasedOn="{StaticResource TagBadgeText}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasFired}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModeBadge" TargetType="Border" BasedOn="{StaticResource TagBadge}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Mode}" Value="SoundOnly">
                <Setter Property="Background" Value="{DynamicResource PendulumBadgeSoundOnlyBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="SoundAndSpeech">
                <Setter Property="Background" Value="{DynamicResource PendulumBadgeSoundAndSpeechBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Mode}" Value="SpeechOnly">
                <Setter Property="Background" Value="{DynamicResource PendulumBadgeSpeechOnlyBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ReminderPillBadge" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="5,0,5,0"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="services:PaletteBrush.Background" Value="{Binding DisplayColor}"/>
        <Setter Property="services:PaletteBrush.BorderBrush" Value="{Binding DisplayColor}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasFired}" Value="True">
                <Setter Property="services:PaletteBrush.Background" Value="{x:Null}"/>
                <Setter Property="services:PaletteBrush.BorderBrush" Value="{x:Null}"/>
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ReminderPillText" TargetType="TextBlock" BasedOn="{StaticResource TagBadgeText}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasFired}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OverflowChip" TargetType="ToggleButton">
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="2,0,2,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PopupBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PendulumPopupBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="16" ShadowDepth="3" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SettingsGroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="SettingsRowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <Style x:Key="SettingsHelp" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,2,0,12"/>
    </Style>

    <Style x:Key="SettingsCheckHelp" TargetType="TextBlock" BasedOn="{StaticResource SettingsHelp}">
        <Setter Property="Margin" Value="28,0,0,12"/>
    </Style>

    <Style x:Key="SettingsGroup" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SettingsField" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="260"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="SettingsNumber" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="Width" Value="64"/>
        <Setter Property="ClearButtonEnabled" Value="False"/>
    </Style>

    <Style x:Key="SettingsUnit" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="SettingsButtons" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="SettingsSecondary" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <DataTemplate x:Key="SettingsTtsEngineName">
        <TextBlock x:Name="Name" Text="{x:Static res:Strings.Settings_WindowsBuiltIn}"/>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="{x:Static models:TextToSpeechEngine.Piper}">
                <Setter TargetName="Name" Property="Text" Value="{x:Static res:Strings.Settings_PiperOfflineMoreNatural}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="SettingsSttEngineName">
        <TextBlock x:Name="Name" Text="{x:Static res:Strings.Settings_WindowsBuiltIn}"/>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="{x:Static models:SpeechToTextEngine.Whisper}">
                <Setter TargetName="Name" Property="Text" Value="{x:Static res:Strings.Settings_WhisperOfflineMoreAccurate}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <GridLength x:Key="SettingsLabelWidth">220</GridLength>
    <Style x:Key="SettingsSliderRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,4,0,10"/>
    </Style>

    <Style x:Key="SettingRow" TargetType="controls:SettingRow">
        <Setter Property="LabelWidth" Value="{StaticResource SettingsLabelWidth}"/>
        <Setter Property="Margin" Value="0,4,0,10"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingRow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{TemplateBinding LabelWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter ContentSource="Header">
                            <ContentPresenter.Resources>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock Text="{Binding}" Style="{StaticResource SettingsRowLabel}"/>
                                </DataTemplate>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <ContentPresenter Grid.Column="1" ContentSource="Content"/>
                        <ContentPresenter Grid.Row="1" Grid.Column="1" Content="{TemplateBinding Footer}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
