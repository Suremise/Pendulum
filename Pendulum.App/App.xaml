<Application x:Class="Pendulum.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pendulum.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Pendulum's own accent brushes: AppThemeManager sets each per theme. These are the
                 dark theme's, until it runs. The accent marks the selected tab and the panel's
                 frame, today in the calendar and the sort arrows; links take their own shade, readable
                 on light and dark alike. The calendar's chips are tints of it. -->
            <SolidColorBrush x:Key="PendulumAccentBrush" Color="#F56A8F"/>
            <SolidColorBrush x:Key="PendulumAccentSoftBrush" Color="#29F56A8F"/>
            <SolidColorBrush x:Key="PendulumAccentTextBrush" Color="#FF8FB0"/>
            <SolidColorBrush x:Key="PendulumChipBrush" Color="#47F56A8F"/>
            <SolidColorBrush x:Key="PendulumChipStrokeBrush" Color="#73F56A8F"/>
            <SolidColorBrush x:Key="PendulumPopupBrush" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="PendulumBadgeFixedBrush" Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="PendulumBadgeDisabledBrush" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="PendulumBadgeSoundOnlyBrush" Color="#597A8CA6"/>
            <SolidColorBrush x:Key="PendulumBadgeSoundAndSpeechBrush" Color="#59C08A6E"/>
            <SolidColorBrush x:Key="PendulumBadgeSpeechOnlyBrush" Color="#59A08A96"/>
            <SolidColorBrush x:Key="PendulumLinkBrush" Color="#FF8FB0"/>
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource PendulumLinkBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
