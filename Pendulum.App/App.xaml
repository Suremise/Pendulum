<Application x:Class="Pendulum.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pendulum.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Links in the theme's link colour (AppThemeManager sets it per theme), readable on
                 light and dark alike. -->
            <SolidColorBrush x:Key="PendulumLinkBrush" Color="#A99CF5"/>
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource PendulumLinkBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
