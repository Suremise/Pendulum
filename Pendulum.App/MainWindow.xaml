<ui:FluentWindow x:Class="Pendulum.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Pendulum.App.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Pendulum.App.Views"
        mc:Ignorable="d"
        Title="{x:Static res:Strings.App_Name}"
        Height="800" Width="1200"
        MinHeight="560" MinWidth="820"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Pendulum;component/Resources/pendulum.ico"
        ExtendsContentIntoTitleBar="True"
        Closing="FluentWindow_Closing"
        Closed="FluentWindow_Closed">
    <Window.Resources>

        <Style x:Key="PendulumTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Cursor="Hand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="3"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="HighlightBg" Grid.Row="0" Background="Transparent" CornerRadius="6,6,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                    <TextBlock x:Name="IconText" Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               Margin="0,0,10,0" VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" VerticalAlignment="Center"
                                                       TextBlock.Foreground="{TemplateBinding Foreground}"
                                                       TextBlock.FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="Indicator" Grid.Row="1" Background="Transparent" CornerRadius="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource PendulumAccentBrush}"/>
                                <Setter TargetName="HighlightBg" Property="Background" Value="{DynamicResource PendulumAccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PendulumTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                            </Border>
                            <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="10" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource PendulumAccentBrush}"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    Padding="20,12">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Windows' own controls: minimise, maximise/restore (with Windows 11's snap layouts under
             the pointer) and close; a double-click on the title bar maximises and restores. -->
        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Title="{x:Static res:Strings.App_Name}"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True" CanMaximize="True"/>

        <!-- The menu bar: access keys from the underscores in its strings (Alt+F, Alt+V, ...); the
             shortcuts it shows are the main window's KeyBindings (MainWindow.xaml.cs). -->
        <Menu x:Name="MainMenu" Grid.Row="1" Margin="20,0,20,0" Background="Transparent">
            <MenuItem Header="{x:Static res:Strings.Menu_File}">
                <MenuItem x:Name="NewReminderMenuItem" Header="{x:Static res:Strings.Menu_NewReminder}"
                          InputGestureText="{x:Static res:Strings.Menu_NewReminderShortcut}" Click="NewReminder_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Add24"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="ImportMenuItem" Header="{x:Static res:Strings.Menu_Import}" Click="Import_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowImport24"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="ExportMenuItem" Header="{x:Static res:Strings.Menu_Export}" Click="Export_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowExportUp24"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="ExitMenuItem" Header="{x:Static res:Strings.Menu_Exit}" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.Menu_View}">
                <MenuItem x:Name="ViewRemindersMenuItem" Header="{x:Static res:Strings.Menu_Reminders}" Click="ViewReminders_Click"/>
                <MenuItem x:Name="ViewCalendarMenuItem" Header="{x:Static res:Strings.Menu_Calendar}" Click="ViewCalendar_Click"/>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.Menu_Tools}">
                <MenuItem x:Name="SettingsMenuItem" Header="{x:Static res:Strings.Menu_Settings}"
                          InputGestureText="{x:Static res:Strings.Menu_SettingsShortcut}" Click="Settings_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Settings24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.Menu_Help}">
                <MenuItem x:Name="CheckForUpdatesMenuItem" Header="{x:Static res:Strings.Menu_CheckForUpdates}" Click="CheckForUpdates_Click"/>
                <Separator/>
                <MenuItem x:Name="AboutMenuItem" Header="{x:Static res:Strings.Menu_About}" Click="About_Click">
                    <MenuItem.Icon><ui:SymbolIcon Symbol="Info24"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <TabControl x:Name="MainTabControl" Grid.Row="2" Margin="28,8,28,20" Style="{StaticResource PendulumTabControl}">
            <TabItem x:Name="FixedTriggersTab" Header="{x:Static res:Strings.Main_Reminders}" Tag="&#xE823;" Style="{StaticResource PendulumTabItem}">
                <views:TriggersPanel x:Name="TriggersPanelControl"/>
            </TabItem>
            <TabItem x:Name="CalendarTab" Header="{x:Static res:Strings.Main_Calendar}" Tag="&#xE787;" Style="{StaticResource PendulumTabItem}">
                <views:CalendarPanel/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Text="{x:Static res:Strings.Status_NoUpcoming}" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <TextBlock x:Name="UpdateAvailableText" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed">
                    <Run x:Name="UpdateAvailableRun"/>
                    <Hyperlink Click="UpdateAvailableLink_Click"><Run Text="{x:Static res:Strings.Main_ViewRelease}"/></Hyperlink>
                </TextBlock>

            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
