<ui:FluentWindow x:Class="Pendulum.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Pendulum.App.Views"
        mc:Ignorable="d"
        Title="Pendulum"
        Height="800" Width="1200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/pendulum.ico"
        ExtendsContentIntoTitleBar="True"
        Closing="FluentWindow_Closing"
        Closed="FluentWindow_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="PendulumAccentBrush" Color="#FF7C6AE0"/>
        <SolidColorBrush x:Key="PendulumAccentSoftBrush" Color="#297C6AE0"/>

        <Style x:Key="PendulumTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Cursor="Hand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="3"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="HighlightBg" Grid.Row="0" Background="Transparent" CornerRadius="6,6,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                    <TextBlock x:Name="IconText" Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               Margin="0,0,10,0" VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                                    <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" VerticalAlignment="Center"
                                                       TextBlock.Foreground="{TemplateBinding Foreground}"
                                                       TextBlock.FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="Indicator" Grid.Row="1" Background="Transparent" CornerRadius="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource PendulumAccentBrush}"/>
                                <Setter TargetName="HighlightBg" Property="Background" Value="{StaticResource PendulumAccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PendulumTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                            </Border>
                            <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="10" BorderThickness="1.5"
                                    BorderBrush="{StaticResource PendulumAccentBrush}"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    Padding="20,12">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Pendulum" ShowMaximize="False"/>

        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="28,12,28,20" Style="{StaticResource PendulumTabControl}">
            <TabItem x:Name="FixedTriggersTab" Header="Reminders" Tag="&#xE823;" Style="{StaticResource PendulumTabItem}">
                <views:TriggersPanel x:Name="TriggersPanelControl"/>
            </TabItem>
            <TabItem Header="Stopwatch" Tag="&#xE121;" Style="{StaticResource PendulumTabItem}">
                <views:StopwatchPanel/>
            </TabItem>
            <TabItem Header="Countdown" Tag="&#xE916;" Style="{StaticResource PendulumTabItem}">
                <views:CountdownPanel/>
            </TabItem>
            <TabItem Header="Settings" Tag="&#xE713;" Style="{StaticResource PendulumTabItem}">
                <views:SettingsPanel/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <TextBlock x:Name="StatusText" Text="No upcoming reminders" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="8,4" Click="AboutButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="About" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
