<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.2.0</Version>
    <Product>Pendulum</Product>
    <Company>Darren Marshall</Company>
    <Copyright>Copyright © 2026 Darren Marshall</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\assets\icon\pendulum.ico</ApplicationIcon>
    <AssemblyName>Pendulum</AssemblyName>
    <RootNamespace>Pendulum.App</RootNamespace>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="WPF-UI" Version="3.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pendulum.Core\Pendulum.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\assets\icon\pendulum.ico" Link="Resources\pendulum.ico" />
    <Resource Include="..\assets\tray\tray.ico" Link="Resources\tray.ico" />
  </ItemGroup>

  <!-- Every user-visible string, English to start (Resources\Strings.resx). The Strings class is
       generated from it before the XAML is compiled, so a missing key is a compile error and XAML
       reads them with {x:Static res:Strings.Key}. -->
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)Strings.Designer.cs" Visible="false" />
  </ItemGroup>
  <Target Name="GeneratePendulumStrings" BeforeTargets="MarkupCompilePass1;CoreCompile"
          Inputs="Resources\Strings.resx" Outputs="$(IntermediateOutputPath)Strings.Designer.cs">
    <GenerateResource Sources="Resources\Strings.resx" OutputResources="$(IntermediateOutputPath)StringsClass.resources"
                      StronglyTypedLanguage="CSharp" StronglyTypedNamespace="Pendulum.App.Resources" StronglyTypedClassName="Strings"
                      StronglyTypedManifestPrefix="Pendulum.App.Resources" StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs"
                      PublicClass="true" ExecuteAsTool="false" />
  </Target>

  <!-- Microsoft's Visual C++ runtime, beside whisper.cpp's native libraries in runtimes\win-x64\
       (they import vcruntime140, vcruntime140_1, msvcp140 and vcomp140, which Windows doesn't
       include). There, not beside Pendulum.exe: Whisper.net loads its libraries by full path with
       Windows' altered search path, which looks in the library's own folder, then System32, never
       the exe's. Copied from Visual Studio's redistributable folder, Microsoft's "Distributable
       Code", under the Microsoft runtime exception recorded in THIRD-PARTY-NOTICES. Found with
       vswhere at its default redistributable version, so local builds and CI ship the same files.
       Without Visual Studio's C++ tools the build warns and goes on (Whisper then needs the
       runtime installed); build-installer.ps1 refuses to package without them. -->
  <Target Name="AddVisualCppRuntime" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <PendulumVsWhere>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</PendulumVsWhere>
    </PropertyGroup>
    <Exec Condition="Exists('$(PendulumVsWhere)')" EchoOff="true" StandardOutputImportance="low"
          Command="&quot;$(PendulumVsWhere)&quot; -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="PendulumVsInstall" />
    </Exec>
    <PropertyGroup>
      <PendulumVcRedistVersionFile>$(PendulumVsInstall)\VC\Auxiliary\Build\Microsoft.VCRedistVersion.default.txt</PendulumVcRedistVersionFile>
      <PendulumVcRedistVersion Condition="'$(PendulumVsInstall)' != '' And Exists('$(PendulumVcRedistVersionFile)')">$([System.IO.File]::ReadAllText('$(PendulumVcRedistVersionFile)').Trim())</PendulumVcRedistVersion>
      <PendulumVcRedistDir>$(PendulumVsInstall)\VC\Redist\MSVC\$(PendulumVcRedistVersion)\x64</PendulumVcRedistDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(PendulumVcRedistVersion)' != ''">
      <PendulumVcRuntime Include="$(PendulumVcRedistDir)\Microsoft.VC*.CRT\vcruntime140.dll;$(PendulumVcRedistDir)\Microsoft.VC*.CRT\vcruntime140_1.dll;$(PendulumVcRedistDir)\Microsoft.VC*.CRT\msvcp140.dll;$(PendulumVcRedistDir)\Microsoft.VC*.OpenMP\vcomp140.dll" />
      <None Include="@(PendulumVcRuntime)" Link="runtimes\win-x64\%(Filename)%(Extension)" Visible="false"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Warning Condition="'@(PendulumVcRuntime->Count())' != '4'"
             Text="Visual Studio's Visual C++ redistributable files weren't found, so the Visual C++ runtime isn't copied beside whisper.cpp's libraries: Whisper will need it installed. Install Visual Studio's C++ build tools to ship it." />
  </Target>

  <ItemGroup>
    <None Include="Resources\Sounds\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Sounds\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
