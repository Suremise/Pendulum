# Text files are stored with LF in the repository and checked out with LF.
* text=auto eol=lf

# Windows tools expect CRLF in these: PowerShell and batch scripts, the Inno Setup
# script and Visual Studio's solution file.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf
*.sln text eol=crlf

# Binary files: never converted or diffed as text.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.7z binary
*.msi binary
*.bin binary
*.onnx binary
