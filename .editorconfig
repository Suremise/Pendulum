# The code's own layout, checked in CI by dotnet format --verify-no-changes.
root = true

[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,xaml,xml,json,yml,yaml}]
indent_size = 2

[*.{ps1,psm1,psd1,bat,cmd,iss,sln}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
